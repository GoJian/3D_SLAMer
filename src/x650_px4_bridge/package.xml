<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x650_px4_bridge</name>
  <version>0.0.0</version>
  <description>Frame/time conversion and external-odometry transport to PX4 (ROS 2 `VehicleOdometry` over uXRCE-DDS, decision 0004).</description>
  <maintainer email="164676+GoJian@users.noreply.github.com">Jian Gong</maintainer>
  <license>TBD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>x650_common</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>px4_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
