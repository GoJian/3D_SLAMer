<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x650_px4_bridge</name>
  <version>0.0.0</version>
  <description>Frame/time conversion and external-odometry transport to PX4 (ROS 2 `VehicleOdometry` or MAVLink `ODOMETRY`, chosen after pinning PX4).</description>
  <maintainer email="gojian@gmail.com">GoJian</maintainer>
  <license>TBD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>diagnostic_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
