<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x650_camera</name>
  <version>0.0.0</version>
  <description>Camera acquisition with acquisition metadata: USB webcam (V4L2) capture now; ZED X / ZED SDK wrapper when the driver is available.</description>
  <maintainer email="164676+GoJian@users.noreply.github.com">Jian Gong</maintainer>
  <license>TBD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rclcpp_components</depend>
  <depend>x650_msgs</depend>
  <depend>x650_common</depend>
  <exec_depend>v4l-utils</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
