#!/usr/bin/env python3
"""Publish static TF (base_link -> imu_link -> cam_i_optical) from a versioned calibration.

  ros2 run x650_description calibration_tf_publisher --ros-args -p calibration:=<dir or yaml>
"""
import rclpy
from geometry_msgs.msg import TransformStamped
from rclpy.node import Node
from tf2_ros.static_transform_broadcaster import StaticTransformBroadcaster

from x650_description.calibration import load, static_transforms


class CalibrationTfPublisher(Node):
    def __init__(self):
        super().__init__('calibration_tf_publisher')
        path = self.declare_parameter('calibration', '').value
        schema_dir = self.declare_parameter('schema_dir', '').value or None
        base = self.declare_parameter('base_frame', 'base_link').value
        imu = self.declare_parameter('imu_frame', 'imu_link').value
        if not path:
            raise SystemExit('parameter "calibration" is required')
        calib = load(path, schema_dir)
        self._bc = StaticTransformBroadcaster(self)
        msgs = []
        for st in static_transforms(calib, base, imu):
            m = TransformStamped()
            m.header.stamp = self.get_clock().now().to_msg()
            m.header.frame_id, m.child_frame_id = st.parent, st.child
            m.transform.translation.x, m.transform.translation.y, m.transform.translation.z = st.translation
            r = m.transform.rotation
            r.x, r.y, r.z, r.w = st.rotation_xyzw
            msgs.append(m)
        self._bc.sendTransform(msgs)
        self.get_logger().info(
            f'calibration {calib["calibration_id"]} ({calib["calibration_hash"]}): '
            + ', '.join(f'{m.header.frame_id}->{m.child_frame_id}' for m in msgs))


def main():
    rclpy.init()
    node = CalibrationTfPublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
